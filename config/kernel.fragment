# Merged on top of `make tinyconfig`. Keep this list honest and short.
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
# ACPI so `poweroff` actually exits QEMU
CONFIG_PCI=y
CONFIG_ACPI=y
# Serial-only appliance: omit unused emulated desktop/input subsystems.
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_SERIO=n
