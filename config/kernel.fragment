# Merged on top of `make tinyconfig`. Keep this list honest and short.
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PROC_FS=y
# Muslin uses procfs and devtmpfs directly; no userspace component needs sysfs.
# CONFIG_SYSFS is not set
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
# ACPI so `poweroff` actually exits QEMU
CONFIG_PCI=y
CONFIG_ACPI=y
# Minimal virtio network stack for QEMU user-mode networking.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
# CONFIG_VIRTIO_PCI_LEGACY is not set
# Persistent root disk.
CONFIG_BLOCK=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
# mpkg serializes transactions with advisory locks released on process exit.
CONFIG_FILE_LOCKING=y
# Networking defaults pull in several server-sized subsystems; Muslin needs
# only IPv4/TCP and one virtio NIC here.
# CONFIG_IPV6 is not set
# CONFIG_INET_DIAG is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_PPS is not set
# CONFIG_BQL is not set
CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_CUBIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_DEFAULT_RENO=y
# Serial-only appliance: omit unused emulated desktop/input subsystems.
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_SERIO is not set
